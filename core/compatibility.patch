-    def __init__(self, rows):
-        self.rows = rows
-        self.token = self.value = None
-
-    def get(self):
-        token = get_current_replay_token()
-        if self.value is None or token != self.token:
-            self.value, self.token = int(self.rows.item()), token
-        return self.value
