+    def forward(
+        self,
+        hidden_states,
+        encoder_hidden_states,
+        timestep,
+        layouts,
+        condition_latents=None,
+        prefix_caches=None,
+        prefix_kv=None,
+        prefix_pad=None,
+        **kwargs,
