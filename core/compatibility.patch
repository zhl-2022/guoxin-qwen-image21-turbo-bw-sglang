-            apply_modulation(
-                state["hidden_states"], self.img_norm1, prefix_modulation[0]
-            )
-            if not cache
-            else None
-            for state, cache in zip(prefix_states, caches, strict=True)
-        ]
-        attention, prefix_attentions = self.attn(
-            apply_modulation(hidden_states, self.img_norm1, scale1),
