+def _gather_tensor_parallel_activation(
+    x: torch.Tensor, linear: nn.Module
+) -> torch.Tensor:
+    tp_group = getattr(linear, "tp_group", None)
+    if tp_group is None:
+        return x
+    return tensor_model_parallel_all_gather(x, tp_group=tp_group)
