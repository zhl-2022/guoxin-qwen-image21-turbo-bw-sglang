-    def forward(
-        self,
-        hidden_states,
-        modulation,
-        prefix_states,
-        prefix_modulation,
-        layouts,
-        ropes,
-        caches,
-        prefix_pad,
-    ):
-        # Cache-DiT's UnifiedBlocks forwards the same args to every layer.
-        # Slice here so prefix KV stays per-layer after that wrap.
-        caches = [cache[self._layer_id] for cache in caches]
