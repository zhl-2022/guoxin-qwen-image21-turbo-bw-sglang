-class QwenImage21ZeroCenterRMSNorm(nn.Module):
-    def __init__(self, dim, eps):
-        super().__init__()
-        self.weight = nn.Parameter(torch.zeros(dim))
-        self.eps = eps
-
-    def forward(self, x):
-        scale = self.weight.float() + 1
-        value = x.float()
-        return (
-            value
-            * torch.rsqrt(value.square().mean(-1, keepdim=True) + self.eps)
-            * scale
-        ).to(x.dtype)
-
