+def digest(path):
+    value = hashlib.sha256()
+    with path.open("rb") as stream:
+        while block := stream.read(8 * 1024 * 1024):
+            value.update(block)
+    return value.hexdigest()
+
+
+def event(name, **values):
+    print(json.dumps({"event": name, **values}), flush=True)
+
+
