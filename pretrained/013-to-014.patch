+    assert not any(parameter.is_meta for parameter in model.parameters())
+    # Check actual payload values after native custom loaders and before native
+    # post-load packing. Select bounded source first/last and custom first/last
+    # candidates, at most32MiB each; large embedding tensors are excluded.
+    from safetensors import safe_open
+    candidates = {}
+    for row in rows:
+        with safe_open(checkpoint_root / row["path"], framework="pt", device="cpu") as handle:
+            for name in handle.keys():
+                shape = handle.get_slice(name).get_shape()
+                count = 1
+                for dim in shape: count *= dim
+                if count * 2 <= 32 * 1024**2:
+                    target = map_name(component, name)
+                    assert target not in candidates
+                    candidates[target] = (row["path"], name)
+    names = sorted(candidates)
+    custom_names = sorted(set(names) & original_custom)
+    selected = list(dict.fromkeys([names[0], names[-1]] +
+        ([custom_names[0], custom_names[-1]] if custom_names else [])))
+    parameters = dict(model.named_parameters())
+    value_checks = []
+    for name in selected:
+        filename, source_name = candidates[name]
+        with safe_open(checkpoint_root / filename, framework="pt", device="cpu") as handle:
+            reference = handle.get_tensor(source_name)
+            actual = parameters[name].detach().cpu().contiguous()
+            assert actual.shape == reference.shape and actual.dtype == reference.dtype
+            assert torch.equal(actual, reference), "Loaded native parameter value differs: " + name
+            def bits(value):
+                return hashlib.sha256(value.contiguous().reshape(-1).view(torch.uint8).numpy().tobytes()).hexdigest()
+            actual_sha, reference_sha = bits(actual), bits(reference)
+            assert actual_sha == reference_sha
+            value_checks.append({"parameter": name, "source_name": source_name,
+                "bytes": actual.numel() * actual.element_size(), "dtype": str(actual.dtype),
+                "actual_sha256": actual_sha, "source_sha256": reference_sha,
+                "native_custom_weight_loader": name in original_custom, "exact_equal": True})
+    # Recompute only the exact two known nonpersistent positional caches using
+    # their genuine original methods/classes. No parameter or unknown buffer is
+    # synthesized. Dtypes follow the already-constructed native meta buffer.
+    rebuilt = []
+    for module_name, module in model.named_modules():
+        for name, value in list(module._buffers.items()):
+            if value is None:
+                continue
+            if value.is_meta:
+                if name == "cos_sin_cache" and type(module).__module__.startswith("sglang.srt.layers.rotary_embedding."):
+                    actual = module._compute_cos_sin_cache()
+                elif name == "inv_freq" and type(module).__name__ == "Qwen3VLVisionRotaryEmbedding":
